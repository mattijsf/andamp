    <string name="prefs_widget_limits_title">Good to know</string>
    <string name="prefs_widget_limit_corners_title">The corners are trimmed</string>
    <string name="prefs_widget_limit_corners_body">Android rounds off the corners of every widget, from every app, and there is no way to turn that off. A smaller player would leave room to spare, but it would also make the buttons harder to hit, so it keeps its size.</string>
    <string name="prefs_widget_limit_icon_title">It can be replaced by an icon</string>
    <string name="prefs_widget_limit_icon_body">To save battery, Android sometimes stops apps it thinks you are done with. When that happens the home screen shows an Andamp icon in place of the player - one tap brings it back. It should not happen often.</string>
    <string name="prefs_widget_limit_loop_title">The bars are on a loop</string>
    <string name="prefs_widget_limit_loop_body">About half a second of the music is turned into pictures, and the home screen plays those round and round until a fresh half second replaces them. So the bars move with the music without ever being quite in step with it. Keeping up beat for beat would mean sending new pictures many times a second, which is what flattens a battery.</string>
    <string name="prefs_widget_limit_running_title">The bars need the player running</string>
    <string name="prefs_widget_limit_running_body">Tapping the position or volume bar tells the player to move, so if Android has cleared Andamp from memory there is nothing to tell it and the tap does nothing. The buttons still work: pressing one starts the player again, and the bars follow.</string>

    <!-- WidgetSettings.kt -->
    <string name="prefs_widget_size_fill">Fill</string>
    <string name="prefs_widget_size_fill_summary">Grows to the edge of the space. The art is scaled to an in-between size, so it looks slightly softer.</string>
    <string name="prefs_widget_size_largest">Largest</string>
    <string name="prefs_widget_size_largest_summary">The largest size that keeps the art perfectly sharp. Leaves a little space around it.</string>
    <string name="prefs_widget_refresh_low">Low</string>
    <string name="prefs_widget_refresh_low_summary">Kindest to the battery. The time moves in jumps, and the visualizer catches up with the song now and then.</string>
    <!-- With the visualizer off, when the clock is all that moves. -->
    <string name="prefs_widget_refresh_low_time_only">Kindest to the battery. The time moves in jumps rather than ticking.</string>
    <string name="prefs_widget_refresh_medium">Medium</string>
    <string name="prefs_widget_refresh_medium_summary">A fair balance. The time ticks along, and the visualizer catches up with the song every few seconds.</string>
    <string name="prefs_widget_refresh_high">High</string>
    <string name="prefs_widget_refresh_high_summary">Uses the most battery. The time ticks, and the visualizer catches up with the song as often as a widget can.</string>
    <!-- Medium and High with the visualizer off: both step the clock every second. -->
    <string name="prefs_widget_refresh_ticking_time_only">The time ticks along, second by second.</string>
</resources>
