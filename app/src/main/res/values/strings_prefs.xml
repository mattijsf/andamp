    <!-- Notices.kt -->
    <string name="prefs_notice_projectm_what">The Milkdrop visualizer engine, rendering .milk presets.</string>
    <!-- The pinned projectM version, twice. -->
    <string name="prefs_notice_projectm_obligation">Andamp links projectM %1$s dynamically, as a separate library in the app, so it can be replaced. The source for that exact revision is tag v%1$s at the address above, and the glue Andamp builds around it is in its own repository. No changes were made to projectM.</string>
    <string name="prefs_notice_avs_what">Winamp\'s visualizer, reimplemented in Kotlin from Nullsoft\'s released source.</string>
    <string name="prefs_notice_avs_decoder_what">The .avs preset format\'s framing and field layouts, as the preset reader follows them.</string>
    <string name="prefs_notice_projectm_eval_what">Evaluates the expressions AVS presets are scripted in, built into the AVS library.</string>
    <string name="prefs_notice_milkdrop_what">Ryan Geiss\'s original, whose .milk presets projectM renders.</string>
    <string name="prefs_notice_webamp_what">Its sprite maps are the ground truth for every coordinate in the skinned windows.</string>
    <string name="prefs_notice_liberation_sans_what">The playlist\'s font, metric-compatible with the Arial that PLEDIT.TXT names.</string>
    <string name="prefs_notice_liberation_sans_obligation">Bundled unmodified, under a name the license permits.</string>
    <string name="prefs_notice_luaj_what">Runs the .lua files that describe effects, in a sandbox.</string>
    <string name="prefs_notice_androidx_what">The UI toolkit, navigation, lifecycle, and Media3 for local playback.</string>
    <string name="prefs_notice_kotlin_what">The language and its concurrency library.</string>
    <string name="prefs_notice_material_what">Its color engine grows the modern screens\' palette from the loaded skin.</string>
    <string name="prefs_notice_coil_what">Loads and caches the skin museum\'s thumbnails.</string>
    <string name="prefs_notice_okhttp_what">The one HTTP client, for the skin museum and for radio streams.</string>

