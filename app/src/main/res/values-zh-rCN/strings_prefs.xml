    <string name="prefs_widget_size_title">大小</string>
    <string name="prefs_widget_logo_title">只有徽标可打开 Andamp</string>
    <string name="prefs_widget_logo_summary">点按播放器本身没有反应，这样没点准按钮时仍会留在主屏幕上。</string>
    <string name="prefs_widget_volume_title">音量控制</string>
    <string name="prefs_widget_volume_summary">允许点按音量滑块。它离进度条很近，容易误触。</string>
    <string name="prefs_widget_limits_title">须知</string>
    <string name="prefs_widget_limit_corners_title">边角会被裁切</string>
    <string name="prefs_widget_limit_corners_body">Android 会把所有应用的所有小部件的边角变成圆角，而且无法关闭。把播放器缩小可以留出余量，但按钮也会更难点中，所以它保持原来的大小。</string>
    <string name="prefs_widget_limit_icon_title">它可能被图标取代</string>
    <string name="prefs_widget_limit_icon_body">为了省电，Android 有时会停止它认为您已不再使用的应用。这时主屏幕上会用 Andamp 图标代替播放器，点一下即可恢复。这种情况应该不常发生。</string>
    <string name="prefs_widget_limit_loop_title">柱状条是循环播放的</string>
    <string name="prefs_widget_limit_loop_body">大约半秒的音乐会被转换成图片，主屏幕循环播放这些图片，直到新的半秒把它们替换掉。因此柱状条会随音乐跳动，但并不完全同步。要做到逐拍同步，就得每秒发送很多次新图片，而这正是最耗电的做法。</string>
    <string name="prefs_widget_limit_running_title">进度条和音量条需要播放器在运行</string>
    <string name="prefs_widget_limit_running_body">点按进度条或音量条是在告诉播放器去调整，所以如果 Android 已把 Andamp 从内存中清除，就没有可以接收指令的对象，点按不会有反应。按钮仍然有效：按下任意一个都会重新启动播放器，之后进度条和音量条也会恢复。</string>

    <!-- WidgetSettings.kt -->
    <string name="prefs_widget_size_fill">填满</string>
    <string name="prefs_widget_size_fill_summary">放大到空间的边缘。画面会缩放到非整数倍大小，因此看起来略微柔和。</string>
    <string name="prefs_widget_size_largest">最大</string>
    <string name="prefs_widget_size_largest_summary">能让画面保持完全清晰的最大尺寸。四周会留出一点空隙。</string>
    <string name="prefs_widget_refresh_low">低</string>
    <string name="prefs_widget_refresh_low_summary">最省电。时间会跳着更新，可视化效果偶尔才跟上歌曲。</string>
    <string name="prefs_widget_refresh_low_time_only">最省电。时间会跳着更新，而不是逐秒走动。</string>
    <string name="prefs_widget_refresh_medium">中</string>
    <string name="prefs_widget_refresh_medium_summary">比较均衡。时间逐秒走动，可视化效果每隔几秒跟上歌曲一次。</string>
    <string name="prefs_widget_refresh_high">高</string>
    <string name="prefs_widget_refresh_high_summary">最耗电。时间逐秒走动，可视化效果以小部件所能达到的最高频率跟上歌曲。</string>
    <string name="prefs_widget_refresh_ticking_time_only">时间逐秒走动。</string>
