<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug builds only: ScreenshotWallpaper sets the device's wallpaper. Android
      has no shell command that does, so this receiver sets it.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application>
        <!--
          Exported so `adb shell am broadcast` can reach it, and guarded by DUMP
          so nothing else can: the shell holds that permission and an ordinary
          app cannot.
        -->
        <receiver
            android:name="nl.mattix.andamp.debug.ScreenshotWallpaper"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
          Modern skins over adb: `adb shell am broadcast` turns them on or off, runs a check of the
          skins in the app's external wal-check folder, and switches how they are drawn and timed
          (see WalDevSwitch). Guarded like the receiver above.
        -->
        <receiver
            android:name="nl.mattix.andamp.wal.WalDevSwitch"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
          A bare desktop to show behind the translucent player: the wallpaper,
          Andamp's icon and a search bar. Guarded like the receiver: only the
          shell starts it. A task of its own, because starting it in the app's
          task would clear the player out of the way.
        -->
        <activity
            android:name="nl.mattix.andamp.debug.ScreenshotDesktop"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="nl.mattix.andamp.screenshotdesktop"
            android:theme="@style/ScreenshotDesktop" />

        <!-- Proof of concept: modern (.wal) skins, in the launcher of debug builds only. -->
        <activity
            android:name="nl.mattix.andamp.debug.ModernSkinActivity"
            android:exported="true"
            android:label="${modernSkinsLabel}"
            android:launchMode="singleTop"
            android:taskAffinity="nl.mattix.andamp.modernskin"
            android:theme="@style/Theme.AndAmp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
