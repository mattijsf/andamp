<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      setWakeMode, and AudioManners for a backend that renders its own audio:
      the CPU may not sleep mid-track, and a stream needs the radio too
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      ACCESS_NETWORK_STATE, which StationRedial's network watch needs, comes
      from :core:network's own manifest, beside the watcher itself
    -->

    <application>
        <!--
          Android Auto lists an app that says it plays media and has a service
          a browser can connect to. The car draws its own player and list from
          the session and the playlist that service gives it.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name="nl.mattix.andamp.backend.media3.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!--
              The second action is the platform's browser interface, which is
              the one a car connects through.
            -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!--
              Media buttons addressed to the package reach playback here. The
              home screen widget sends these.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
    </application>

</manifest>
