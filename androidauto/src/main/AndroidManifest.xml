<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android Auto gives a surface to draw on to navigation apps, which is why
      this app is declared as one. It draws nothing itself: the surface is lent
      to the player, which shows its main window there.
    -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- the player, whose service this app binds to -->
    <queries>
        <package android:name="nl.mattix.andamp" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- 5 is the first level that reports a tap on the surface with its place -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="5" />

        <service
            android:name=".AndroidAutoService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>

</manifest>
